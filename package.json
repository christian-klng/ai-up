{
  "name": "ai-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --env-file-if-exists=.env.local watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts src/server/db/migrate.ts --bundle --platform=node --target=node22 --outdir=dist --outbase=. --packages=external --format=cjs",
    "test": "vitest run",
    "worker:start": "node dist/worker/index.js"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.0",
    "bullmq": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "linkedom": "^0.18.13",
    "liquidjs": "^10.29.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
