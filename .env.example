# --- App -------------------------------------------------------------
# Public URL of the app (no trailing slash). Used for links in e-mails and auth callbacks.
APP_URL=http://localhost:3000
NODE_ENV=development
APP_TIMEZONE=Europe/Berlin
DEFAULT_LOCALE=de
# First admin: this e-mail is auto-activated with role=admin on first start.
SEED_ADMIN_EMAIL=you@example.com

# --- Secrets (generate with: openssl rand -base64 32) -----------------
BETTER_AUTH_SECRET=change-me-please-32-bytes-minimum
# 32-byte key, base64 encoded, used to encrypt provider credentials at rest
APP_ENCRYPTION_KEY=change-me-please-base64-32-bytes

# --- Data stores ------------------------------------------------------
DATABASE_URL=postgres://aiup:aiup@localhost:5432/aiup
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500

# --- E-Mail (SMTP) ----------------------------------------------------
# Local dev: docker compose -f docker-compose.dev.yml up starts Mailpit on :1025 (UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI-Up <no-reply@example.com>"

# --- Workflows --------------------------------------------------------
WORKFLOW_CONCURRENCY=4

# --- Nextcloud (spike only – production values are managed in the admin UI) ---
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
